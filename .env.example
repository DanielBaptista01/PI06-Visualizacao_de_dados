# Copie este arquivo para .env somente no ambiente local.
# Nunca versione credenciais reais.

# APIs
OPEN_CHARGE_MAP_API_KEY=sua_chave_aqui

# PostgreSQL / PostGIS
# Exemplo: postgresql://usuario:senha@host:5432/postgres?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require

# Object Storage compatível com S3
# Para Supabase, use os valores exibidos na configuração S3 do projeto.
S3_ENDPOINT_URL=https://seu-endpoint-s3
S3_REGION=sua_regiao
S3_ACCESS_KEY_ID=seu_access_key_id
S3_SECRET_ACCESS_KEY=seu_secret_access_key
S3_BUCKET=pi06-raw

# Opcionais do pipeline
# PI_OUTPUT_DIR=dados_limpos
# PI_CACHE_DIR=dados_cache
# PI_REPORT_DIR=dados_relatorios
# FIPE_API_BASE=https://fipe.parallelum.com.br/api/v2/cars
