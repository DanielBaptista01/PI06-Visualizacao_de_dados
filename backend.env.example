# Arquivo de exemplo. Copie as variáveis para o .env LOCAL (não versionar .env real).
# Para a carga, utilizar DATABASE_URL com permissão de escrita/migration no banco de desenvolvimento.
# DATABASE_URL=postgresql://usuario_carga:senha@host:5432/postgres?sslmode=require
# Para API, utilizar credencial somente de LEITURA e preferencialmente a pooler do Supabase.
# PI06_API_DATABASE_URL=postgresql://usuario_leitura:senha@host:5432/postgres?sslmode=require
# Origens de frontend autorizadas; nunca usar * com tokens/cookies.
PI06_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
